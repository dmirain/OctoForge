.venv/
__pycache__/
*.egg-info/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
.env
# every variant, not just the exact name: a `.env.bak.HHMMSS` written before
# an edit is the same secrets under a name nothing was ignoring
.env.*
!.env.example
octoforge.db
telegram.db
# SQLite writes these beside the database it is journalling; they are the
# live state of a local run, and one committed by accident is a corrupt
# database for whoever checks it out next
*.db-shm
*.db-wal
# what ops/trace_queries.py leaves behind on the host it profiled
octoforge_trace
*.bak
backups/
OctoForgeBotToken.txt
logs/
.claude/scheduled_tasks.lock
