# OpenAI-compatible LLM endpoint used by the core proxy
OF_LLM_BASE_URL=https://api.openai.com/v1
OF_LLM_API_KEY=sk-...
OF_LLM_MODEL=gpt-4o-mini

# Local ollama example (OpenAI-compatible endpoint)
# OF_LLM_BASE_URL=http://localhost:11434/v1
# OF_LLM_API_KEY=ollama
# OF_LLM_MODEL=deepseek-v4-pro:cloud

# Database (async SQLAlchemy URL)
OF_DATABASE_URL=sqlite+aiosqlite:///./octoforge.db

# OpenAI-compatible embeddings endpoint (instructions store/search)
OF_EMBEDDING_BASE_URL=https://api.openai.com/v1
OF_EMBEDDING_API_KEY=sk-...
OF_EMBEDDING_MODEL=text-embedding-3-small

# Local ollama embeddings example
# OF_EMBEDDING_BASE_URL=http://localhost:11434/v1
# OF_EMBEDDING_API_KEY=ollama
# OF_EMBEDDING_MODEL=nomic-embed-text

# Instructions search default top-k
# OF_INSTRUCTIONS_TOP_K=5

# Datasets (data_query skill) record limits: default and maximum per query
# OF_DATASETS_QUERY_DEFAULT_LIMIT=50
# OF_DATASETS_QUERY_MAX_LIMIT=200

# Memory (memory_search skill) result limits: default and maximum per query
# OF_MEMORY_SEARCH_DEFAULT_LIMIT=10
# OF_MEMORY_SEARCH_MAX_LIMIT=50

# Process model: max active processes per dialog and LLM router timeout (seconds)
# OF_MAX_PROCESSES=5
# OF_ROUTER_TIMEOUT_SECONDS=10.0

# Internal auth injected by external_call for whitelisted base-url prefixes (JSON)
# OF_EXTERNAL_CALL_AUTH_WHITELIST=[{"base_url_prefix": "https://internal.example.com/", "header_name": "X-Api-Key", "header_value": "secret"}]

# Own base URL: the app's HTTP API as seen by the agent's external_call (cron tools
# point here; allowlisted in the SSRF guard and gets a per-user X-User-Id header)
# OF_SELF_BASE_URL=http://127.0.0.1:8000

# Cron scheduler: poll interval (seconds), claim lease TTL (seconds), per-tick replay limit
# OF_CRON_POLL_INTERVAL_SECONDS=1.0
# OF_CRON_LEASE_TTL_SECONDS=60.0
# OF_CRON_REPLAY_LIMIT=5
