# OpenAI-compatible LLM endpoint used by the core proxy
OF_LLM_BASE_URL=https://api.openai.com/v1
OF_LLM_API_KEY=sk-...
OF_LLM_MODEL=gpt-4o-mini

# Local ollama example (OpenAI-compatible endpoint)
# OF_LLM_BASE_URL=http://localhost:11434/v1
# OF_LLM_API_KEY=ollama
# OF_LLM_MODEL=deepseek-v4-pro:cloud

# Operator credential. Everything the HTTP surface serves — the chat UI, the
# dialog API, the console at /admin.html, /docs — sits behind HTTP Basic; only
# /health and /health/ready stay open. Empty means 503, never "open".
# Generate: python tools/hash_password.py
# OF_ADMIN_USERNAME=admin
# OF_ADMIN_PASSWORD_HASH=pbkdf2_sha256:240000:<salt>:<digest>

# Public name and TLS. Caddy obtains and renews the Let's Encrypt certificate
# for SITE_DOMAIN itself; ACME_EMAIL receives the expiry notices.
# SITE_DOMAIN=example.org
# ACME_EMAIL=you@example.org
# OF_SELF_BASE_URL=https://example.org

# NOTE: docker compose interpolates `$` in this file, so a value containing one
# arrives mangled in the container. Keep secrets `$`-free (the password hash
# uses `:` separators for exactly this reason) or escape it as `$$`.

# Database (async SQLAlchemy URL). SQLite is the zero-setup default and has
# exactly one writer, so a single process only. Postgres is the deployment
# target (`docker compose up -d postgres` serves it on 127.0.0.1:5432, and the
# compose app service overrides these two URLs to reach it over the internal
# network):
#   OF_DATABASE_URL=postgresql+asyncpg://octoforge:octoforge@127.0.0.1:5432/octoforge
OF_DATABASE_URL=sqlite+aiosqlite:///./octoforge.db

# Embeddings backend: "local" (sentence-transformers in-process, as in b2e)
# or "openai" (OpenAI-compatible HTTP endpoint, the default).
#
# Touch nothing here and the HTTP backend inherits OF_LLM_BASE_URL and
# OF_LLM_API_KEY — one gateway serving chat and embeddings is the common case,
# and the alternative was `recall` silently unavailable. Setting either
# OF_EMBEDDING_API_KEY or OF_EMBEDDING_BASE_URL turns the inheritance off.
# Only OF_EMBEDDING_MODEL still has to name a model that endpoint serves.
# OF_EMBEDDING_BACKEND=local
# Local backend: Hugging Face model name (cached in ~/.cache/huggingface)
# OF_EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct
# OF_EMBEDDING_BATCH_SIZE=16
# Optional cross-encoder reranker for instruction search (empty = disabled)
# OF_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# OF_RERANKER_CANDIDATES=20
# Reranker backend: with OF_RERANKER_API_KEY the HTTP API is used
# (SiliconFlow-compatible POST /rerank), without it the local in-process
# cross-encoder (heavy on CPU)
# OF_RERANKER_API_KEY=sf-...
# OF_RERANKER_API_URL=https://api.siliconflow.cn/v1/rerank
# OF_RERANKER_TIMEOUT_SECONDS=30
# OpenAI-compatible backend (requires OF_EMBEDDING_BACKEND=openai and a key)
# OF_EMBEDDING_BASE_URL=https://api.openai.com/v1
# OF_EMBEDDING_API_KEY=sk-...
# OF_EMBEDDING_MODEL=text-embedding-3-small

# Instructions search default top-k
# OF_INSTRUCTIONS_TOP_K=5

# Datasets (data_query skill) record limits: default and maximum per query
# OF_DATASETS_QUERY_DEFAULT_LIMIT=50
# OF_DATASETS_QUERY_MAX_LIMIT=200

# Dialog context compaction (characters, a ~4:1 proxy of tokens): hot-tail limit
# that triggers background summarization, and the target size of one compressed segment
# OF_CONTEXT_HOT_MAX_CHARS=12000
# OF_CONTEXT_COMPACT_TARGET_CHARS=6000

# Token-based compaction trigger (provider-reported usage): the model's context
# window (0 = disabled) and the safety buffer subtracted from it
# OF_MODEL_CONTEXT_TOKENS=0
# OF_CONTEXT_BUFFER_TOKENS=2000

# History (history_search skill) result limits: default and maximum per query
# OF_HISTORY_SEARCH_DEFAULT_LIMIT=20
# OF_HISTORY_SEARCH_MAX_LIMIT=100

# Process model: max active processes per dialog and LLM router timeout (seconds)
# OF_MAX_PROCESSES=5
# OF_ROUTER_TIMEOUT_SECONDS=10.0

# Idle timeout between LLM stream events, seconds (0 = disabled; a local model
# may think long before the first token, so keep it comfortably high)
# OF_LLM_STREAM_IDLE_TIMEOUT_SECONDS=120.0

# Retries of transient LLM failures (rate limit / provider 5xx / transport):
# max attempts, backoff base (seconds), backoff ceiling (seconds)
# OF_LLM_MAX_RETRIES=3
# OF_LLM_RETRY_BASE_SECONDS=1.0
# OF_LLM_RETRY_MAX_SECONDS=30.0

# Internal auth injected by external_call for whitelisted base-url prefixes (JSON)
# OF_EXTERNAL_CALL_AUTH_WHITELIST=[{"base_url_prefix": "https://internal.example.com/", "header_name": "X-Api-Key", "header_value": "secret"}]

# Own base URL: the app's HTTP API as seen by the agent's external_call (cron tools
# point here; allowlisted in the SSRF guard and gets a per-user X-User-Id header)
# OF_SELF_BASE_URL=http://127.0.0.1:8000

# Cron scheduler: poll interval (seconds), claim lease TTL (seconds), per-tick replay limit
# OF_CRON_POLL_INTERVAL_SECONDS=1.0
# forwarded material waits this long for a question before the agent
# reacts to it on its own; the sweep looks for settled collections
# vision: images are described by a separate model (empty model = off).
# Base URL and key fall back to the main LLM's when left empty.
OF_VISION_MODEL=minimax-m3
# strong tier used only by the image_look tool (empty = tool hidden)
OF_VISION_DEEP_MODEL=qwen3.5:397b
OF_VISION_BASE_URL=
OF_VISION_API_KEY=
# Voice messages: speech-to-text. NO fallback to the main LLM endpoint —
# /audio/transcriptions is a different endpoint kind and a chat-only gateway
# 404s on it, so URL and model must both be set or the feature stays off.
# Groq's free tier covers a personal deployment (20 rpm, 2000 rpd, 8h audio/day).
OF_STT_BASE_URL=
OF_STT_API_KEY=
OF_STT_MODEL=
# recognizer language hint; empty leaves autodetection on
OF_STT_LANGUAGE=
# longest recording accepted, in seconds (latency and daily audio quota guard)
OF_VOICE_MAX_SECONDS=600.0
OF_MATERIAL_QUIET_SECONDS=30.0
OF_MATERIAL_SWEEP_INTERVAL_SECONDS=10.0
# OF_CRON_LEASE_TTL_SECONDS=60.0
# OF_CRON_REPLAY_LIMIT=5

# Telegram adapter (empty token = disabled): bot token from @BotFather,
# long-poll timeout (seconds), draft message edit throttle (seconds)
# OF_TELEGRAM_BOT_TOKEN=123456:ABC-...
# OF_TELEGRAM_POLL_TIMEOUT_SECONDS=30.0
# OF_TELEGRAM_EDIT_THROTTLE_SECONDS=1.5

# Upgrade final answers with tables/task lists/details/math to native Rich
# Messages (Bot API 10.1); the streaming draft stays on the HTML path

# Telegram invites: admin Telegram user ids (comma-separated; admins pass the
# membership gate without an invite and get the admin_manage tool) and the
# dedicated database of invite codes (separate from OF_DATABASE_URL: its own
# Base, no Alembic — on Postgres that means a second database on the same server)
# OF_TELEGRAM_ADMIN_IDS=123456,789012
# The bot's public @handle. Only the Bot API knows it, so it is configuration,
# never a constant in the code: with it set, admin_manage hands out an invite as
# a t.me deep link (one tap for the recipient) instead of a bare code. Accepts
# `name`, `@name` or a t.me URL.
# OF_TELEGRAM_BOT_USERNAME=octoforge_demo_bot
# OF_TELEGRAM_DATABASE_URL=sqlite+aiosqlite:///./telegram.db
# OF_TELEGRAM_DATABASE_URL=postgresql+asyncpg://octoforge:octoforge@127.0.0.1:5432/octoforge_telegram

# How long a generated invite code stays claimable, seconds (default 3 days);
# an expired code stays in the database but can no longer be claimed
# OF_TELEGRAM_INVITE_TTL_SECONDS=259200

# Origins the raw http_request tool may call (comma-separated, empty = the open
# web). The SSRF guard always blocks private address space; this is the other
# half — an agent that read a prompt-injected page cannot post a dialog's
# contents to an address nobody listed here.
# OF_HTTP_REQUEST_ALLOWLIST=https://api.partner.example,https://status.example.org

# Wall-clock ceiling on a single tool call. A tool that never returns holds its
# iteration open forever and freezes that dialog until the process restarts.
# A timeout is reported to the model as ordinary tool output, so it can try
# something else rather than the whole run failing.
# OF_AGENT_TOOL_TIMEOUT_SECONDS=180.0

# How long to keep each kind of row, in days. Unset or 0 means FOREVER, which is
# the default for all three — nothing is ever deleted until you say so here.
#
# Only transcript-shaped data ages out. Instructions, datasets and their records
# are things a user wrote on purpose (a skill, a memory, a food diary) and are
# never touched by retention.
#
# The sweep runs at startup and refuses to remove: a message at or after its
# dialog's compaction boundary (the runner reloads those to rebuild its
# narrative), an exchange that is still live, and a task whose result has not
# been delivered yet.
# OF_RETENTION_MESSAGES_DAYS=0
# OF_RETENTION_EXCHANGES_DAYS=0
# OF_RETENTION_TASKS_DAYS=0

# Web search via serper.dev (empty token = web_search skill disabled)
# OF_SERPER_TOKEN=...

# Core prompt overrides (empty = built-in defaults; only the file: scheme is
# supported, the file is re-read on every dialog turn — no restart needed;
# the router prompt is a template with {limit}/{processes} placeholders)
# Per-user secrets (the /secrets flow): master key of the encrypted store.
# Empty disables the feature. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# OF_SECRETS_KEY=
# Public base URL used in user-facing links (/secrets one-time form);
# defaults to OF_SELF_BASE_URL.
# OF_PUBLIC_BASE_URL=https://example.com

# System-skill overlay: replace/extend/add registry scenarios without a rebuild
# (JSON list of {type, title, content|append, tags?}); docker compose mounts
# docker/system_skills.ru.json there. See docs/instructions.md.
# OF_SYSTEM_SKILLS_SOURCE=file:/etc/octoforge/system_skills.json

# OF_SYSTEM_PROMPT_SOURCE=file:/etc/octoforge/system_prompt.txt
# OF_ROUTER_PROMPT_SOURCE=file:/etc/octoforge/router_prompt.txt

# Agent loop iteration cap per run (one iteration = one LLM call + its tool round).
# The runaway backstop, not a target: normal runs finish on their own well below it.
# OF_AGENT_MAX_ITERATIONS=10
